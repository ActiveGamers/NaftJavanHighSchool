APP_NAME="هنرستان جوار شرکت پالایش نفت بندرعباس"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=naftjavan-

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=naftjavan-school
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Image conversions (Spatie Media Library)
# ---------------------------------------------------------------------------
# `imagick` is the only driver the application image installs (see the
# Dockerfile); `gd` and `vips` are not available inside the container.
IMAGE_DRIVER=imagick

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Broadcasting
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=371139
REVERB_APP_KEY=cefvpwghtkvsm8cudg8g
REVERB_APP_SECRET=jnbndhxgocgrpwonyatd
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SANCTUM_TOKEN_PREFIX=naft-

# ---------------------------------------------------------------------------
# School profile (config/school.php reads these two; the rest is static)
# ---------------------------------------------------------------------------
# Link to the school on a map service. Leave empty until it is published.
SCHOOL_MAP_URL=
# Founding year of the school. Leave empty until it is confirmed.
SCHOOL_FOUNDED_YEAR=
